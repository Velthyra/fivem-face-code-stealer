<Window x:Class="FaceSt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FaceSt Studio" Width="1060" Height="740" MinWidth="940" MinHeight="690"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#0B0E14">
  <Border Margin="8" Background="{StaticResource WindowFrame}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="64"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="46"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="{StaticResource Card}" CornerRadius="13,13,0,0" MouseLeftButtonDown="DragHeader">
        <Grid Margin="20,0,16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="38"/>
            <ColumnDefinition Width="38"/>
          </Grid.ColumnDefinitions>

          <Border Width="36" Height="36" Background="{StaticResource AccentSubtle}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="9" VerticalAlignment="Center">
            <TextBlock Text="FS" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="FaceSt" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
              <TextBlock Text="STUDIO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="8,2,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Karakter yüz kodu aracı" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
          </StackPanel>

          <Border Grid.Column="2" Background="{StaticResource AccentSubtle}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="12" Padding="12,4" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="FACE CODE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
          </Border>

          <Button Grid.Column="3" Content="─" FontSize="14" Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0" Cursor="Hand" Click="MinimizeClick"/>
          <Button Grid.Column="4" Content="✕" FontSize="14" Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0" Cursor="Hand" Click="CloseClick"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1" x:Name="DisclaimerPage" Margin="24,16">
        <Border Width="790" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="52" Height="52" Background="{StaticResource AccentSubtle}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="12">
                <TextBlock Text="FS" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Başlamadan önce" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="FaceSt Studio · Kullanım bilgileri" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
              </StackPanel>
              <Border Grid.Column="2" Background="{StaticResource AccentSubtle}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
                <TextBlock Text="FACE CODE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
              </Border>
            </Grid>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{StaticResource CardAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel>
                  <TextBlock Text="Yerel kayıt" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,6"/>
                  <TextBlock Text="Çıkarılan yüz kodları bu bilgisayarda FaceSt/Codes klasörüne kaydedilir." FontSize="12" Foreground="{StaticResource InkDim}" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="{StaticResource CardAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel>
                  <TextBlock Text="Sunucu kuralları" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,6"/>
                  <TextBlock Text="Kullandığınız FiveM sunucusunun kurallarını kontrol edin. Araç oyun sürecine okuyucu yükler." FontSize="12" Foreground="{StaticResource InkDim}" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
              </Border>
            </Grid>

            <Border Background="{StaticResource CardAlt}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Geliştirici sorumluluk reddi" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,7"/>
                <TextBlock Text="Bu yazılım kendi sorumluluğunuzda kullanılır. Kullanımından doğabilecek hesap yasakları, hesap veya veri kaybı ve diğer olumsuz sonuçlardan geliştirici sorumlu tutulamaz. Devam ederek bu riskleri bildiğinizi ve kabul ettiğinizi beyan edersiniz." FontSize="12" Foreground="{StaticResource InkDim}" TextWrapping="Wrap" LineHeight="19"/>
              </StackPanel>
            </Border>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="184"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Yüz verisi yalnızca oyunda yüklenmiş karakterlerden okunabilir." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0"/>
              <Button x:Name="AcceptButton" Grid.Column="1" Content="Lütfen bekleyin... (10 sn)" IsEnabled="False" Style="{StaticResource PrimaryButton}" Height="44" FontSize="13" Click="AcceptDisclaimerClick"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1" x:Name="WorkbenchPage" Visibility="Collapsed" Margin="20,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="360"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock Text="Hedef Karakter Seçimi" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
              <TextBlock Text="Kendi karakterinizi veya 250m çevredeki oyuncuyu seçin." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="InjectButton" Content="INJECT" Style="{StaticResource PrimaryButton}" Height="36" Click="InjectClick"/>
              <Button x:Name="UninjectButton" Grid.Column="2" Content="DURDUR" Style="{StaticResource DangerButton}" Height="36" Click="UninjectClick"/>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource CardAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,10,0,0">
              <TextBlock x:Name="ReaderStatus" Text="○ OKUYUCU YÜKLENMEDİ" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource AccentSubtle}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,10,0,0">
              <TextBlock Text="💡 Sunucu ID boş bırakılırsa doğrudan kendi karakterinizin yüzü okunur." FontSize="11" Foreground="{StaticResource InkDim}" TextWrapping="Wrap"/>
            </Border>

            <Grid Grid.Row="4" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FiveM Sunucu ID" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="Hedef oyuncunun oyun içi ID'si" FontSize="10" Foreground="{StaticResource Muted}"/>
              </StackPanel>
              <TextBox x:Name="TargetIdBox" Grid.Column="1" Height="36" MaxLength="5" HorizontalContentAlignment="Center" FontSize="14" FontWeight="Bold"/>
            </Grid>

            <Button Grid.Row="5" x:Name="FindButton" Content="🔍  YAKINDAKİLERİ TARA (250M)" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,12,0,8" Click="FindClick"/>

            <Border Grid.Row="6" Background="{StaticResource CardAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="3">
              <ListBox x:Name="NearbyList" Background="Transparent" BorderThickness="0" SelectionChanged="NearbySelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="ItemBorder" Property="Background" Value="#21262D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSubtle}"/>
                              <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBorder}"/>
                              <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
            </Border>

            <TextBlock Grid.Row="7" x:Name="ActionStatus" Text="Önce INJECT ile okuyucuyu FiveM'e yükleyin." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxHeight="38" Margin="0,8,0,0"/>

            <Button Grid.Row="8" x:Name="CaptureButton" Content="YÜZ KODUNU ÇIKAR" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,10,0,0" Click="CaptureClick"/>
          </Grid>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Karakter Yüz Kodu" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="Oyun içi kuaför / estetik menülerine yapıştırılabilir JSON kodu." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
              </StackPanel>
              <Border Grid.Column="1" Background="{StaticResource AccentSubtle}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="9" Padding="12,5" VerticalAlignment="Center">
                <TextBlock x:Name="SexText" Text="KARAKTER: —" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
              </Border>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource Line}" Margin="0,14,0,12"/>

            <Border Grid.Row="2" Background="{StaticResource CardAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="4">
              <TextBox x:Name="CodeBox" Text="Yüz kodu oluşturulduğunda burada görünecektir." IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Foreground="{StaticResource Muted}" Background="Transparent" BorderThickness="0" Padding="10"/>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="CopyButton" Content="KODU KOPYALA" Style="{StaticResource PrimaryButton}" Height="40" IsEnabled="False" Click="CopyClick"/>
              <Button Grid.Column="2" x:Name="FolderButton" Content="📁  KLASÖRÜ AÇ" Style="{StaticResource SecondaryButton}" Height="40" IsEnabled="False" Click="FolderClick"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="{StaticResource CardAlt}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13">
        <Grid Margin="20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="GameDot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" Grid.Column="1" Text="FiveM bekleniyor..." Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="2" Text="FACEST STUDIO  •  v1.1.0" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
