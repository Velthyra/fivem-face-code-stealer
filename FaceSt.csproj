<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FaceSt</AssemblyName>
    <RootNamespace>FaceSt</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>facest.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FaceSt.Core">
      <HintPath>Payload\FaceSt.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <EmbeddedResource Include="Payload\FaceStReader.dll" LogicalName="FaceSt.FaceStReader.dll" />
    <EmbeddedResource Include="Payload\FaceCodeInjector.exe" LogicalName="FaceSt.FaceCodeInjector.exe" />
  </ItemGroup>
</Project>
